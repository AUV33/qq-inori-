    "report:tokens": "node scripts/token-report.mjs",
    "freedom:report": "node scripts/freedom-report.mjs",
    "learning:report": "node scripts/learning-report.mjs",
    "state:overview": "node scripts/state-overview.mjs",
    "audit:learning": "node scripts/audit-learning-loop.mjs",
    "backup:state": "node scripts/backup-state.mjs",
    "audit:architecture": "node scripts/check-architecture.mjs",
    "audit:wiring": "node scripts/audit-wiring.mjs",
